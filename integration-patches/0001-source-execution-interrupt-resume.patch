+      return summary(input, authorize(input))
+    }),
+    resume: input => safe(async () => {
+      const ticket = authorize(input), pause = pausedExecution(ticket)
+      if (pause && deps.interruptionStatus?.(ticket.id, pause.seq) !== 'settled') throw new SourceExecutionError(409, 'interruptionPending', 'Worker interruption has not been acknowledged')
