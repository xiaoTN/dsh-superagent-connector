+/** Source execution adapter: authorization, transactional controls, and bounded passive worker history. */
+import type { SessionHistoryRecord } from '@deepseek-ai/dsh-api-session-controller'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import { latestAssignment, pausedExecution, UserError, type Engine, type Ticket } from '../core/index.ts'
+import { workerSessionId } from '../executor/dsh.ts'
+import { SourceExecutionError } from '../sources/execution.ts'
+import type { SourceExecution, ExecutionScope, ExecutionSummary, ExecutionRecord } from '../sources/execution.ts'
+import type { Store } from './store.ts'
+
+export interface SourceExecutionDeps {
+  store: Pick<Store, 'threads' | 'tickets' | 'triggers' | 'atomic'>
+  engine: Pick<Engine, 'interruptTicket' | 'resumeTicket'>
+  /** Structural cold-read seam: alpha inspect+page and RC events/page with optional cut. */
+  controller: object
+  activity?(ticketId: string): ExecutionSummary['activity']
+  interruptionStatus?(ticketId: string, controlSeq: number): 'requested' | 'settled' | 'failed'
+  waitForInterruption?(ticketId: string, assignmentId: string, controlSeq: number): Promise<void>
+}
+interface ColdController {
+  inspect?(id: SessionId, signal?: AbortSignal): Promise<{ events: readonly { seq: number }[] }>
+  page?(request: { address: { kind: 'session'; sessionId: SessionId }; throughSeq?: number; beforeSeq?: number; maxMessages: number }, signal: AbortSignal): Promise<{ records: readonly SessionHistoryRecord[]; hasMore: boolean; cursor?: number }>
+  events?: ColdController['page']
+}
+const MAX_RECORDS = 100, MAX_BYTES = 128 * 1024, MAX_TEXT = 8000
+const object = (value: unknown): Record<string, unknown> => value && typeof value === 'object' && !Array.isArray(value)
+  ? value as Record<string, unknown> : {}
+/** Text is display-only; redact recognized credential formats even when a worker printed one. */
+function display(value: string): string {
+  return value.slice(0, MAX_TEXT * 2).replace(/\bBearer\s+[^\s"']+/gi, 'Bearer [redacted]')
+    .replace(/\b(?:sk-[a-zA-Z0-9_-]{8,}|gh[pousr]_[a-zA-Z0-9_]+|github_pat_[a-zA-Z0-9_]+)\b/g, '[redacted]')
+    .replace(/((?:["']?)(?:api[_-]?key|access[_-]?token|refresh[_-]?token|token|password|secret|authorization|credential)["']?\s*[=:]\s*)(?:"[^"]*"|'[^']*'|[^\s,;}]+)/gi, '$1[redacted]')
+    .replace(/-----BEGIN [^-]*PRIVATE KEY-----[\s\S]*?(?:-----END [^-]*PRIVATE KEY-----|$)/g, '[private key redacted]')
+    .replace(/https?:\/\/[^\s/@:]+:[^\s/@]+@/gi, 'https://[redacted]@').slice(0, MAX_TEXT)
+}
+/** Explicit projection, not recursive passthrough: reasoning, prompts, tool args/results, raw config and errors stay private. */
+function visible(raw: unknown): ExecutionRecord | undefined {
+  const event = object(raw), data = object(event.data)
+  if (!Number.isSafeInteger(event.seq) || Number(event.seq) < 0 || typeof event.time !== 'number' || !Number.isFinite(event.time)) return
+  const type = event.type
+  let safe: Record<string, unknown> | undefined
+  if (type === 'user/message' || type === 'assistant/message') {
+    const message = object(data.message ?? data)
+    const text = Array.isArray(message.content) ? message.content.slice(0, 128).flatMap(block => {
+      const item = object(block)
+      return item.type === 'text' && typeof item.text === 'string' ? [display(item.text)] : []
+    }).join('\n').slice(0, MAX_TEXT) : ''
+    if (text) safe = { text }
+  } else if (typeof type === 'string' && /^(turn|step)\/(start|end)$/.test(type)) {
+    safe = {}
+    for (const name of ['turn', 'step']) if (Number.isSafeInteger(data[name])) safe[name] = data[name]
+  } else if (type === 'tool/call' || type === 'tool/result') {
+    safe = typeof data.name === 'string' ? { name: display(data.name).slice(0, 120) } : {}
+  } else if (type === 'llm/request' || type === 'llm/response') {
