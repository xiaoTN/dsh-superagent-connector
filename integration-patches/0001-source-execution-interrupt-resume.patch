+  try { return await work() } catch (error) {
+    if (error instanceof SourceExecutionError) throw error
+    if (error instanceof UserError) {
+      if (error.code === 'executionScope') throw new SourceExecutionError(403, error.code, 'Execution does not belong to this Source conversation')
+      if (['unknownTicket', 'unknownAssignment'].includes(error.code)) throw new SourceExecutionError(404, error.code, 'Execution not found')
+      if (['ticketEnded', 'staleAssignment', 'staleControl', 'executionPaused', 'executionNotPaused', 'mandateRevoked'].includes(error.code)) {
