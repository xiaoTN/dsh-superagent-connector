+    }),
+    read: input => safe(async () => {
+      const ticket = authorize(input)
+      if (Object.keys(input).some(key => !['threadKey', 'ticketId', 'cursor', 'limit'].includes(key))) throw new UserError('executionScope')
+      const limit = input.limit ?? 50, cursor = input.cursor
+      if (!Number.isSafeInteger(limit) || limit < 0 || limit > MAX_RECORDS || (cursor && (
+        !Number.isSafeInteger(cursor.throughSeq) || cursor.throughSeq < -1 ||
+        (cursor.beforeSeq !== undefined && (!Number.isSafeInteger(cursor.beforeSeq) || cursor.beforeSeq < 0 || cursor.beforeSeq > cursor.throughSeq + 1))
+        || Object.keys(cursor).some(key => !['throughSeq', 'beforeSeq'].includes(key))))) throw new SourceExecutionError(400, 'invalidExecutionWindow', 'Invalid execution history window')
