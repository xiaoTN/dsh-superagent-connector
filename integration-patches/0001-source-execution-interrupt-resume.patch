+      const empty = { records: [] as ExecutionRecord[], hasMore: false, truncated: false }
+      if (limit === 0) return { ...base(), ...empty, history: 'not-read' }
+      // Runtime capability detection, not a dependency-version guess and never private Engine access.
+      const controller = deps.controller as ColdController
