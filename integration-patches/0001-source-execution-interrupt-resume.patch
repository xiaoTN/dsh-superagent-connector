+      || typeof input.expectedAssignmentId !== 'string' || !input.expectedAssignmentId
+      || !Number.isSafeInteger(input.expectedControlSeq) || input.expectedControlSeq < 0) throw new UserError('executionScope')
+    authorize(input)
+    const ticket = resume ? deps.engine.resumeTicket(input.ticketId, input.expectedAssignmentId, input.expectedControlSeq)
