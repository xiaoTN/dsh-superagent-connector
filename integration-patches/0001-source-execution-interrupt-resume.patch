index 0000000..3f83f8e
--- /dev/null
+++ b/src/sources/execution.ts
@@ -0,0 +1,44 @@
+/** Browser-safe, Source-scoped execution interface. No caller chooses a Session or the orchestrator. */
+/** Stable transport-safe failure. No internal stack, cause, filesystem path or raw provider detail crosses the Source seam. */
+export class SourceExecutionError extends Error {
+  override readonly name = 'SourceExecutionError'
+  constructor(readonly status: 400 | 403 | 404 | 409 | 503, readonly code: string, message = 'Execution operation unavailable') {
+    super(message)
+    this.stack = undefined
+  }
+  toJSON(): { name: string; status: number; code: string; message: string } {
+    return { name: this.name, status: this.status, code: this.code, message: this.message }
+  }
+}
+export interface ExecutionScope { threadKey: string; ticketId: string }
+export interface ExecutionControl extends ExecutionScope { expectedAssignmentId: string; expectedControlSeq: number }
+export interface ExecutionCursor { throughSeq: number; beforeSeq?: number }
+export interface ExecutionSummary extends ExecutionScope {
+  version: 1
+  assignmentId?: string
+  state: 'pending' | 'running' | 'paused' | 'ended'
+  /** Observed SDK turn/preparation activity; never inferred from Assignment.state. */
+  activity: 'running' | 'idle' | 'cold' | 'preparing' | 'unknown'
+  pausedAt?: string
+  /** Paused is a durable hold; only settled proves the SDK turn and background work stopped. */
+  interruption?: 'requested' | 'settled' | 'failed'
+  /** Cursor in the ticket control journal; not comparable to worker event seq. */
+  controlSeq: number
+}
+export interface ExecutionRecord { seq: number; time: number; event: { type: string; data: Record<string, unknown> } }
+export interface ExecutionPage extends ExecutionSummary {
+  records: ExecutionRecord[]
+  history: 'available' | 'missing' | 'unsupported' | 'not-read'
+  hasMore: boolean
+  /** Some records/fields were filtered or capped; an empty page need not mean empty history. */
+  truncated: boolean
+  nextCursor?: ExecutionCursor
+}
+/** All methods verify Source kind + thread ownership + ticket subscription, including read and continuation. */
+export interface SourceExecution {
+  readonly version: 1
+  read(input: ExecutionScope & { cursor?: ExecutionCursor; limit?: number }): Promise<ExecutionPage>
+  interrupt(input: ExecutionControl): Promise<ExecutionSummary>
+  /** Human text is intentionally not accepted: send it through Source.receive for normal Trigger audit/admission. */
+  resume(input: ExecutionControl): Promise<ExecutionSummary>
+}
